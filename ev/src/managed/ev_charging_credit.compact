pragma language_version >= 0.20;
import CompactStandardLibrary;

// Private state - each user's charging credits (in kWh)
export ledger chargingCredits: Coin<Zkp>;

// Public state - total charging sessions completed
export ledger totalSessions: Counter;

// Add charging credits to a user (e.g., when they purchase a plan)
export circuit addCredits(amount: Field): [Coin<Zkp>] {
  return [Coin::<Zkp>(amount)];
}

// Use charging credits for an EV charging session
// Input: credit coin representing available credits
// Output: remaining credits after deducting the charging amount
export circuit useCredits(
  creditCoin: Coin<Zkp>,
  chargeAmount: Field
): [Coin<Zkp>] {
  
  // Verify user has enough credits
  assert(creditCoin.amount >= chargeAmount);
  
  // Deduct the charging amount from available credits
  let remainingCredits = creditCoin.amount - chargeAmount;
  
  // Increment the public session counter
  totalSessions.increment(1);
  
  // Return the remaining credits as a new coin
  return [Coin::<Zkp>(remainingCredits)];
}

// Check and transfer credits between users (optional feature)
export circuit transferCredits(
  senderCoin: Coin<Zkp>,
  transferAmount: Field
): [Coin<Zkp>, Coin<Zkp>] {
  
  // Verify sender has enough credits
  assert(senderCoin.amount >= transferAmount);
  
  // Calculate remaining credits for sender
  let senderRemaining = senderCoin.amount - transferAmount;
  
  // Return [sender's remaining credits, recipient's new credits]
  return [Coin::<Zkp>(senderRemaining), Coin::<Zkp>(transferAmount)];
}